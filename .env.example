# Vercel / standard Next.js only. Set these in Vercel Project Settings > Environment Variables.
# Use your actual deployed origin; update the GitHub OAuth callback to match.
AUTH_URL=https://your-project.vercel.app
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Supabase Project > Connect: project URL; Settings > API Keys: secret key.
# Run supabase/schema.sql once in the project's SQL Editor first.
# Use the server secret (sb_secret_...), never a publishable/anon key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_RECEIPTS_BUCKET=receipts

# Comma-separated numeric GitHub IDs prefixed with github:. Empty = no moderators.
# Obtain your ID from https://api.github.com/users/YOUR_USERNAME (the "id" field).
SAVOUR_MODERATOR_IDS=
